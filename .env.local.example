# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic AI (lesson plans and task generation)
ANTHROPIC_API_KEY=

# Upstash Redis (AI rate limiting; optional locally)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public addresses. Production: https://pamokos.kusteam.app for both.
NEXT_PUBLIC_SITE_URL=http://pamokos.localhost:3000
NEXT_PUBLIC_PLAY_URL=http://pamokos.localhost:3000

# Set to the canonical host to redirect the old app./play. hosts there.
# Leave empty locally.
CANONICAL_CLASSROOM_HOST=

# Transactional email through Resend (domain kusteam.app, EU region).
# Without the key, platform emails are skipped and logged; Supabase Auth
# emails (login code, invitation) go through the same account over SMTP,
# configured in the Supabase dashboard.
RESEND_API_KEY=
EMAIL_FROM="KU STEAM DI Lab <noreply@kusteam.app>"
EMAIL_REPLY_TO=steam@ku.lt

# KU STEAM TEAM sign-in (README, "Prisijungimas per KU STEAM TEAM").
# 1 = on; unset = /auth/team/* is 404 and nothing else changes.
TEAM_SSO_ENABLED=
# TEAM's address; default https://komanda.kusteam.app. Tests only, e.g.
# http://127.0.0.1:3100 (TEAM_APP_URL is read too).
TEAM_SSO_URL=
# Optional key for the sign-in flow cookie; unset = derived from
# SUPABASE_SERVICE_ROLE_KEY.
TEAM_SSO_FLOW_SECRET=

# Data retention (docs/scheduled-jobs.md): unset = count only, delete = delete past-term data
RETENTION_MODE=
